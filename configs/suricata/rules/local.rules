# Détection scans de ports
alert tcp any any -> $HOME_NET any (msg:"SCAN Port scan détecté"; flags:S,12; threshold: type threshold, track by_src, seconds 60, count 10; sid:1000001; rev:1;)

# Détection brute force SSH
alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute force potentiel"; flow:to_server; threshold: type threshold, track by_src, seconds 60, count 5; sid:1000002; rev:1;)

# Détection brute force FTP
alert tcp any any -> $HOME_NET 21 (msg:"FTP Brute force potentiel"; flow:to_server; content:"USER"; threshold: type threshold, track by_src, seconds 60, count 5; sid:1000003; rev:1;)

# Détection énumération web
alert tcp any any -> $HOME_NET 80 (msg:"WEB Directory enumeration"; content:"/admin"; threshold: type threshold, track by_src, seconds 60, count 3; sid:1000004; rev:1;)

# Détection tools automatisés
alert tcp any any -> $HOME_NET any (msg:"TOOL Nmap scan détecté"; content:"|00 00 00 00 00 00 00 00|"; depth:8; sid:1000005; rev:1;)